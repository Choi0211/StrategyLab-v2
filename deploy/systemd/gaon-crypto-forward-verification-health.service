[Unit]
Description=Crypto forward-verification collector health check (read-only, no orders)
After=gaon-crypto-forward-verification.service

[Service]
Type=oneshot
User=strategylab
Group=strategylab
WorkingDirectory=/opt/strategylab-v2
# Opens the DB read-write only to allow sqlite3.connect() to create the
# file on a brand-new deployment before the collector's first write; the
# health check itself (gaon.research.crypto_forward_verification.health_check)
# issues SELECT/PRAGMA statements only - it never inserts, updates, or
# deletes a row. Non-zero exit (WARNING/ERROR) is deliberate: it is what
# makes `systemctl --failed` / journal "Result: exit-code" surface a
# stalled collector, stale data, or a corrupted DB without any extra
# alerting plumbing.
ExecStart=/opt/strategylab-v2/.venv/bin/python -m gaon.runtime.cli crypto-forward-verification-health --db /var/lib/strategylab/csm_forward_verification.sqlite
StandardOutput=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/strategylab

[Install]
WantedBy=multi-user.target
