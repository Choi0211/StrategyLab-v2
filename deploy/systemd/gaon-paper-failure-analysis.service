[Unit]
Description=Deterministic failure-analysis hypothesis generation over closed Gaon<->Paper trades (read + append-only, no orders, no promotion)
After=gaon-web.service

[Service]
Type=oneshot
User=strategylab
Group=strategylab
WorkingDirectory=/opt/strategylab-v2
# Reads paper_trade_observations (written by the external Paper engine)
# and appends at most a handful of rows to paper_failure_hypotheses plus
# one research_memories row - idempotent via fingerprints (scripts/
# generate_paper_failure_hypotheses.py), so a no-op run is a normal,
# silent success (exit 0). Never touches strategy_version_registries or
# any ACTIVE strategy state - this can never promote or mutate a
# strategy by itself; see that module's own docstring for why.
ExecStart=/opt/strategylab-v2/.venv/bin/python scripts/generate_paper_failure_hypotheses.py --family-id csm-48h-long --db /var/lib/strategylab/gaon-runtime.sqlite
StandardOutput=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/strategylab

[Install]
WantedBy=multi-user.target
