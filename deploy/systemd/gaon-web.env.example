# gaon-web.service specific settings. General assistant/provider config
# (GAON_ASSISTANT_*) is already loaded from /etc/strategylab/gaon.env by
# this service too - do not duplicate those values here.
#
# Binds to 127.0.0.1 by default so the process itself is never reachable
# from outside this host. External access is added later by putting a
# reverse proxy (see deploy/nginx/strategylab-binance.conf.example) in
# front of this port - do not change GAON_WEB_HOST to 0.0.0.0 as a
# shortcut to "fix" external access; use the reverse proxy instead.
GAON_WEB_HOST=127.0.0.1
GAON_WEB_PORT=8765

# Read-only path to the crypto forward-verification research DB
# (gaon.research.crypto_forward_verification). Opened mode=ro by this
# process; only gaon-crypto-forward-verification.service writes to it.
# Leave unset to hide the admin-page section entirely.
GAON_CRYPTO_FV_DB_PATH=/var/lib/strategylab/csm_forward_verification.sqlite
